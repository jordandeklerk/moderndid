{
  "version": 1,
  "project": "moderndid",
  "project_url": "https://github.com/jordandeklerk/moderndid",
  "repo": "..",
  "branches": ["HEAD"],
  "build_command": [
    "python -m build --wheel -o {build_cache_dir} {build_dir}"
  ],
  "dvcs": "git",
  "environment_type": "virtualenv",
  "pythons": ["3.12"],
  "matrix": {
    "req": {
      "pip+asv_runner": ["0.3.1"],
      "pip+build": ["1.6.1"],
      "numpy": ["2.5.3"],
      "scipy": ["1.18.1"],
      "polars": ["2.0.0"],
      "pyarrow": ["25.0.0"],
      "narwhals": ["2.26.0"],
      "pandas": ["3.0.6"],
      "statsmodels": ["0.15.0"],
      "prettytable": ["3.18.0"],
      "formulaic": ["1.2.2"],
      "numba": ["0.68.0"],
      "llvmlite": ["0.50.0"]
    },
    "env": {
      "OMP_NUM_THREADS": ["1"],
      "OPENBLAS_NUM_THREADS": ["1"],
      "MKL_NUM_THREADS": ["1"],
      "NUMEXPR_NUM_THREADS": ["1"],
      "NUMBA_NUM_THREADS": ["1"],
      "POLARS_MAX_THREADS": ["1"]
    }
  },
  "show_commit_url": "https://github.com/jordandeklerk/moderndid/commit/",
  "benchmark_dir": ".",
  "env_dir": ".asv/env",
  "results_dir": ".asv/results",
  "html_dir": ".asv/html"
}
